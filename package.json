{
  "name": "avaramp",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "AvaRamp — price engine, fee management, SePay integration and Avalanche C-Chain settlement",
  "main": "dist/server.js",
  "engines": {
    "node": ">=v22.22.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx node_modules/.bin/knex migrate:latest --knexfile src/knexfile.ts",
    "migrate:prod": "node node_modules/.bin/knex migrate:latest --knexfile dist/knexfile.js",
    "migrate:rollback": "tsx node_modules/.bin/knex migrate:rollback --knexfile src/knexfile.ts",
    "wallet:add": "tsx scripts/add-wallet.ts",
    "partner:create": "tsx scripts/create-partner.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@google-cloud/kms": "^6.1.0",
    "@payos/node": "^2.0.5",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "sepay-pg-node": "^1.0.0",
    "viem": "^2.56.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
