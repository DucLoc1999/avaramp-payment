# Environment variables for AvaRamp
# -------------------------------------------------
# NOTE — SETTLEMENT CHAIN: Avalanche C-Chain (EVM) only.
# The service settles buy payouts and sell collection exclusively on the
# C-Chain. When spinning up, REPLACE these values (see .env.local for the
# active working copy):
#
#   * C-Chain custodial sell/deposit: CCHAIN_RPC_BASE_URL, CCHAIN_CHAIN_ID,
#     CCHAIN_NATIVE_USDT_ADDRESS, CCHAIN_DEPOSIT_CONFIRMATIONS,
#     MASTER_WALLET_PRIVATE_KEY, CUSTODIAL_KEY_ENCRYPTION_KEY,
#     CCHAIN_LISTENER_FALLBACK_URL / _AUTH_TOKEN.
#   * C-Chain buy payout: CCHAIN_PAYOUT_CONFIRMATIONS, CCHAIN_AVAX_GAS_RESERVE_WEI
#     + GCP_KMS_* (secp256k1 EC_SIGN_SECP256K1_SHA256 key) or
#     CCHAIN_PAYOUT_WALLET_PRIVATE_KEY for local/dev.
#   * *-incoming listener URLs point at the API ingress (see *_FALLBACK_URL).
#
# Keep secrets OUT of git: copy this file to `.env` / `.env.local` and replace
# the blanks with the real values (see .env.local for a working example).

# General server settings
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Client → Service auth (required by all /api/orders* routes)
PARTNER_APP_KEY=               # partner API key header (authorization)
PARTNER_BOOTSTRAP_NAME=        # Optional default partner name, auto-created on startup
PARTNER_BOOTSTRAP_FEE_BUY=     # Default buy fee rate for the bootstrap partner (e.g. 0)
PARTNER_BOOTSTRAP_FEE_SELL=    # Default sell fee rate for the bootstrap partner (e.g. 0)

# SePay configuration
SEPAY_ENV=sandbox               # sandbox or production
SEPAY_WEBHOOK_API_KEY=          # SePay webhook API key (Apikey header)
SEPAY_VA_NUMBER=                # Virtual Account number (optional)
SEPAY_VA_HOLDER=                # Account holder name (optional)
SEPAY_BANK_NAME=                # Bank name (optional)
SEPAY_BANK_SHORT=               # Bank short name (optional)

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=avaramp
DB_SSL=false                    # Enable SSL for DB connection (default: false)
DB_SCHEMA=avaramp               # Schema name (default: avaramp)
DB_PATH=./data/p2p_prices.db         # Path to price DB file (default: ./p2p_prices.db)

# Redis configuration (required for reservation)
REDIS_URL=redis://localhost:6379
RESERVATION_BUFFER_AVAX=1       # Reserve buffer for AVAX (nAVAX)
RESERVATION_RECONCILE_INTERVAL_MS=60000 # Reconcile reservations interval

# Kafka configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=avaramp
KAFKA_DISBURSE_TOPIC=avaramp.disburse_crypto
KAFKA_ORDER_PAID_TOPIC=avaramp.order_paid
KAFKA_TOKEN_IN_TOPIC=avaramp.avax_token_in
# TLS / SASL (required for managed brokers e.g. Aiven). Leave blank for local plaintext.
KAFKA_SSL_CA_PATH=              # Path to CA cert for TLS verification (e.g. /app/data/kafka_ca.pem)
KAFKA_SSL=false                 # Set true to enable TLS without a custom CA (ignored if KAFKA_SSL_CA_PATH is set)
KAFKA_SASL_MECHANISM=scram-sha-256  # plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_USERNAME=            # SASL username (e.g. avnadmin)
KAFKA_SASL_PASSWORD=            # SASL password

# Avalanche C-Chain (EVM) configuration — custodial sell/deposit sweep flow
# (native AVAX + native USDT ERC-20). Users get a per-order custodial deposit
# address; funds are swept to the Master Wallet (USDT via EIP-712 Permit +
# transferFrom, AVAX via self-funded native transfer). All txs use EIP-1559.
ASSET_CODE=AVAX                  # Asset code surfaced to clients (default: AVAX)
CCHAIN_RPC_BASE_URL=              # C-Chain RPC (e.g. https://api.avax-test.network/ext/bc/C/rpc)
CCHAIN_CHAIN_ID=43113             # Avalanche chain id (43113 Fuji, 43114 Mainnet)
CCHAIN_NATIVE_USDT_ADDRESS=0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7  # Native USDT contract
CCHAIN_DEPOSIT_CONFIRMATIONS=25   # Blocks to wait before a deposit is sweepable
CCHAIN_POLL_INTERVAL_MS=5000      # Listener poll interval
CCHAIN_MIN_SWEEP_THRESHOLD=0      # Min deposit (native units) before sweeping (0 = sweep all)
MASTER_WALLET_PRIVATE_KEY=        # Master/sweep destination wallet private key (0x hex)
CUSTODIAL_KEY_ENCRYPTION_KEY=     # >=32 char AES-256-GCM key for custodial private-key-at-rest
CCHAIN_LISTENER_FALLBACK_URL=http://localhost:3000/api/webhooks/cchain-incoming
CCHAIN_LISTENER_FALLBACK_AUTH_TOKEN=
# Run the custodial deposit poll loop inside the API process instead of the
# separate `cchain-listener` worker. Enable in exactly ONE process per
# deployment — multiple loops duplicate C-Chain scans. Default: false.
CCHAIN_LISTENER_IN_API=false
# C-Chain buy payout (fiat → crypto). The payout wallet signs EIP-1559 transfers
# of native AVAX / ERC-20 USDT to the order's 0x recipient. Prefer the GCP KMS
# secp256k1 key (no raw key) and leave the private key unset in production;
# CCHAIN_PAYOUT_WALLET_PRIVATE_KEY is the dev/local fallback.
# CCHAIN_PAYOUT_WALLET_PRIVATE_KEY=0x... (leave unset to use KMS)
CCHAIN_PAYOUT_CONFIRMATIONS=1     # Blocks to wait before a buy payout is final
CCHAIN_AVAX_GAS_RESERVE_WEI=10000000000000000  # AVAX (wei) kept for USDT payout gas (0.01 AVAX)

# GCP Cloud KMS signing (C-Chain payout txs signed in-process via GCP KMS secp256k1,
# algorithm EC_SIGN_SECP256K1_SHA256); the payout address is derived from the key
# version configured below.
GCP_KMS_PROJECT_ID=              # GCP project id (e.g. graceful-envoy-463407-a1)
GCP_KMS_LOCATION_ID=             # KMS location (e.g. asia-southeast1)
GCP_KMS_KEY_RING=                # Key ring name (e.g. avax-wallet)
GCP_KMS_KEY_ID=                  # Crypto key name (e.g. avax-hotwallet-keyring)
GCP_KMS_KEY_VERSION=1            # Key version (default: 1) — controls the active hot wallet

# Admin configuration
ADMIN_JWT_SECRET=change-me      # JWT secret for admin routes (default: change-me)
ADMIN_JWT_TTL_SEC=43200         # JWT TTL in seconds (default: 43200 = 12h)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-too
CMS_CREATE_ADMIN_KEY=           # Partner API key (client → service auth) (optional)

# Callback webhook configuration
CALLBACK_TIMEOUT_MS=8000        # HTTP timeout for callback (default: 8000)
CALLBACK_RETRY_COUNT=3          # Number of retry attempts (default: 3)
CALLBACK_RETRY_DELAY_MS=5000    # Delay between retries (default: 5000)
CALLBACK_SIGNATURE_SECRET=      # HMAC secret for callback signing (shared with client)

# Chain webhook configuration
CHAIN_WEBHOOK_SECRET=           # HMAC secret for chain webhook (provider → service auth)

# Fees and pricing
MIN_FEE_VND=5000                # Minimum fee in VND (default: 5000)
ORDER_EXPIRY_MINUTES=5          # Order expiry time in minutes (default: 5)
PRICE_SOURCE=coingecko          # Price source (coingecko or other) (default: coingecko)
COINGECKO_API_KEY=              # CoinGecko API key (pro tier for AVAX/USDT quotes; blank uses free tier)
P2P_PRICE_MAX_AGE_MS=           # Max age of a cached P2P price (optional), blank = default

# Payout (PayOS) configuration
PAYOUT_MODE=stub                # stub or real (default: stub)
PAYOS_CLIENT_ID=                # PayOS client ID
PAYOS_API_KEY=                  # PayOS API key
PAYOS_CHECKSUM_KEY=             # PayOS checksum key

# NOTE: KYC image storage (AWS_*), ID recognition (GOOGLE_AI_API_KEY, GEMINI_MODEL,
# OCR_SPACE_*, ID_RECOGNITION_PROVIDER), and user authentication (GOOGLE_*,
# USER_JWT_*) moved to the `web-be` service. See web-be/.env.example.

# Landing page snapshot (OKX market data)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

FRONTEND_ORIGIN=               # Frontend app origin for CORS (e.g. https://yourapp.com)
